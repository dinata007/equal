# ---------- Koneksi SQL Server ----------
# Salin file ini menjadi .env lalu isi sesuai server Anda. File .env tidak ikut ke git.

# Nama host / IP server. Untuk named instance (mis. PC\SQLEXPRESS) isi DB_SERVER=PC dan DB_INSTANCE=SQLEXPRESS.
DB_SERVER=localhost
DB_INSTANCE=
# Port diabaikan bila DB_INSTANCE diisi (memakai SQL Browser)
DB_PORT=1433

# Database pengembangan (hasil restore dari aplikasi lama)
DB_NAME=SENJA_DEMO

# Login SQL Server. Untuk login Windows/domain isi juga DB_DOMAIN (autentikasi NTLM).
# Password yang mengandung # atau spasi WAJIB diapit tanda kutip, mis. DB_PASSWORD="rahasia#123"
DB_USER=
DB_PASSWORD=
DB_DOMAIN=

# Enkripsi koneksi. Server lokal/kantor umumnya: DB_ENCRYPT=false atau DB_TRUST_CERT=true (sertifikat self-signed).
DB_ENCRYPT=false
DB_TRUST_CERT=true
