	},
	"devDependencies": {
		"@floating-ui/dom": "^1.8.0",
		"@fontsource-variable/source-sans-3": "^5.3.1",
		"@fontsource/alegreya-sans": "^5.3.0",
		"@lucide/svelte": "^1.59.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/mssql": "^12.3.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
